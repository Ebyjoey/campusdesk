# Generated by Terraform. Do not edit: it is rewritten on every apply.
[jenkins]
jenkins ansible_host=${jenkins_ip} private_ip=10.20.1.10

[k3s_server]
master ansible_host=${master_ip} private_ip=10.20.1.20

[k3s_agent]
worker ansible_host=${worker_ip} private_ip=10.20.2.20

[db]
db ansible_host=${db_ip} private_ip=${db_ip} ansible_ssh_common_args='-o ProxyJump=ubuntu@${jenkins_ip} -o StrictHostKeyChecking=accept-new'

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/campusdesk
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'

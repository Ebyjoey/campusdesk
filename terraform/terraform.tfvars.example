# Copy to terraform.tfvars (git-ignored) and fill in your values.
my_ip_cidr  = "203.0.113.7/32"          # your public IP from: curl -s https://checkip.amazonaws.com
alert_email = "you@example.com"         # CloudWatch alarm emails go here

# Optional overrides
# enable_nat            = false         # set true only while Ansible installs packages on the database host
# worker_instance_type  = "t3.small"    # use this if AWS refuses t3.medium on the Free plan
# app_cidr              = "0.0.0.0/0"   # who may open the app on port 30080
